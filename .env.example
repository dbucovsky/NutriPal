GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth-callback.php

# Used for local-day bucketing in daily-aggregate queries (e.g. "steps today").
# Not stored per-row — a single app-level timezone, not per-user yet.
APP_TIMEZONE=America/New_York

# Local XAMPP MySQL/MariaDB. DB_NAME is the main-data schema; the history
# schema is always DB_NAME + "_hist" (see sql/schema.sql's header) — on
# Bluehost both get the account's db-name prefix, e.g. theshaf2_nutripal /
# theshaf2_nutripal_hist.
DB_HOST=localhost
DB_NAME=nutripal
DB_USER=root
DB_PASS=
